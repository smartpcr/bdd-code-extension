{
  "name": "@bdd-suite/runtime",
  "version": "0.7.11",
  "description": "The TypeScript runtime of the BDD suite format: suiterun lint, run, list and actions, an in-process linter for editors, and an extension API for adding actions, context keys, options and rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartpcr/bdd-code-extension.git",
    "directory": "runtimes/typescript"
  },
  "homepage": "https://github.com/smartpcr/bdd-code-extension/tree/main/runtimes/typescript#readme",
  "bugs": {
    "url": "https://github.com/smartpcr/bdd-code-extension/issues"
  },
  "keywords": [
    "bdd",
    "yaml",
    "testing",
    "suite",
    "gherkin",
    "vitest",
    "jest",
    "mocha",
    "node-test"
  ],
  "type": "module",
  "bin": {
    "suiterun": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p .",
    "sync-core": "node scripts/sync-core.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "lint:types": "tsc -p . --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run build && npm run build:test && c8 --reporter=text --reporter=text-summary --reporter=json-summary --include \"dist-test/src/**\" node --test \"dist-test/test/**/*.test.js\" && node scripts/check-branches.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "typescript": "~5.9.2"
  },
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli.js",
    "./extension": "./dist/extension.js",
    "./testing": "./dist/testing/index.js",
    "./testing/node-reporter": "./dist/testing/node-reporter.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
