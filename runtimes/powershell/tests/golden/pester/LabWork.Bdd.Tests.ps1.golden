# Code generated by suiterun generate (pester) from ../suites/d-lab.yml. DO NOT EDIT.
# Needs the BddSuite module imported (or on PSModulePath) and Pester 5; see the BddSuite README.
Describe 'lab-work' {
    BeforeAll {
        if (-not (Get-Module BddSuite)) { Import-Module BddSuite -DisableNameChecking }
        $context = Get-BddSuiteTestContext -SchemaRoot (Join-Path $PSScriptRoot '../../schema') -Extension @()
        $session = Open-BddSuiteSession -Path (Join-Path $PSScriptRoot '../suites/d-lab.yml') -Shown 'suites/d-lab.yml' -Context $context -Guarded
        Invoke-BddSuiteSetup -Session $session
    }
    AfterAll {
        Complete-BddSuiteSession -Session $session
    }

    It 'reads the group' -Tag 'lab' {
        $outcome = Invoke-BddSuiteTest -Session $session -Case 'reads the group'
        if ($outcome.Skipped) { Set-ItResult -Skipped -Because $outcome.Message }
    }
}
