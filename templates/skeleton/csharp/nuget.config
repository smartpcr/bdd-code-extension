<?xml version="1.0" encoding="utf-8"?>
<!--
  Every package comes from nuget.org, Smartpcr.BddSuite and Smartpcr.BddSuite.Testing included.
  <clear /> drops whatever feeds the machine or a parent folder configures. A machine that reaches
  nuget.org only through a mirror replaces the URL below with the mirror's.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
