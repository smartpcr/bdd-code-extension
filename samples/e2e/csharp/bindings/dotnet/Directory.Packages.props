<Project>

  <!--
    Central package management: a PackageReference carries no version; every version is here.
    BddSuiteVersion is the bdd-suite release these suites are written against. Keep Smartpcr.BddSuite and
    Smartpcr.BddSuite.Testing at the same version, and install the Suite Authoring extension (asz.bdd-suite)
    of that release too: they carry the same core catalog and schema generator.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BddSuiteVersion Condition="'$(BddSuiteVersion)' == ''">0.7.12</BddSuiteVersion>
  </PropertyGroup>
  <ItemGroup>
    <!-- The runtime: suite model, lint, session, reports, and the suiterun command line (Bdd.Suite.Run.Runner). -->
    <PackageVersion Include="Smartpcr.BddSuite" Version="$(BddSuiteVersion)" />
    <!-- The test provider: generates one test class per suite at build, from bddsuite.tests.yaml. -->
    <PackageVersion Include="Smartpcr.BddSuite.Testing" Version="$(BddSuiteVersion)" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>

</Project>
