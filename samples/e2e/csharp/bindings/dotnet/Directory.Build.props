<Project>

  <!--
    The C# binding of the inventory suites. It stands alone: nothing here imports a file outside this
    workspace, and every bdd-suite type comes from the Smartpcr.BddSuite packages on nuget.org (versions
    in Directory.Packages.props beside this file). Build output stays under artifacts\ beside this file,
    which is where .vscode\settings.json points the Suite Authoring extension's tool:
    artifacts\bin\<project>\<configuration>\<tfm>\.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- The runtime is written with nullable annotations; handlers read optional parameters as object?. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <BaseOutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>

</Project>
