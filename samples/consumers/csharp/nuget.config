<?xml version="1.0" encoding="utf-8"?>
<!--
  This consumer restores the bdd-suite packages from the local feed that
  scripts/local-feeds.ps1 fills (docs/packages, DEC-P09), and everything else
  from nuget.org. Package source mapping makes sure a Bdd.Suite package can
  only come from the local feed, so a test can never pass on a package nobody
  built here.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="bdd-suite-local" value="../../../artifacts/feeds/nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bdd-suite-local">
      <package pattern="Bdd.Suite" />
      <package pattern="Bdd.Suite.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
