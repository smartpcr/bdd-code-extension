<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The greeter's suites as XUnit tests. Bdd.Suite.Testing's build targets, which
    NuGet imports, generate one test class per suite on every build from
    ../bddsuite.tests.yaml; the provider is detected from the references below.
  -->
  <ItemGroup>
    <PackageReference Include="Bdd.Suite.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <ProjectReference Include="..\Greeter.Suite\Greeter.Suite.csproj" />
  </ItemGroup>
  <ItemGroup>
    <BddSuiteConfig Include="..\bddsuite.tests.yaml" />
  </ItemGroup>
</Project>
