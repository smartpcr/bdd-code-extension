<Project>
  <!--
    Central package management, as larger repositories use it: a package
    reference carries no version, and a runtime copied in as projects would
    fail restore here (NU1008), which is why consumers take the packages.
    BddSuiteVersion is the release under test; e2.ps1 passes the one it packed.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <BddSuiteVersion Condition="'$(BddSuiteVersion)' == ''">0.7.1</BddSuiteVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Bdd.Suite" Version="$(BddSuiteVersion)" />
    <PackageVersion Include="Bdd.Suite.Testing" Version="$(BddSuiteVersion)" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.3.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.3.2" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
  </ItemGroup>
</Project>
