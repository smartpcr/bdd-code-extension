{
  "name": "bdd-suite",
  "displayName": "Suite Authoring",
  "description": "Write BDD-style YAML test suites whose steps call actions implemented in several languages: navigation between YAML and code, validation and IntelliSense, lint, code generation, and Test Explorer runs. Bindings in PowerShell, C#, Go, Rust and TypeScript.",
  "version": "0.7.10",
  "publisher": "asz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartpcr/bdd-code-extension.git"
  },
  "homepage": "https://github.com/smartpcr/bdd-code-extension#readme",
  "bugs": {
    "url": "https://github.com/smartpcr/bdd-code-extension/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Programming Languages",
    "Testing"
  ],
  "keywords": [
    "bdd",
    "gherkin",
    "given-when-then",
    "yaml",
    "test suite",
    "acceptance testing",
    "code generation",
    "powershell",
    "csharp",
    "go",
    "rust",
    "typescript"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/actions.catalog.yaml",
    "onLanguage:bdd-suite"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Lint, run, build and schema generation run code from the folder and are disabled until it is trusted.",
      "restrictedConfigurations": [
        "bddSuite.bindings",
        "bddSuite.schemaGenerator",
        "bddSuite.lintTool",
        "bddSuite.root"
      ]
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "bdd-suite",
        "aliases": [
          "BDD Suite",
          "bdd-suite"
        ],
        "filenamePatterns": [
          "*suite*.yml",
          "*suite*.yaml",
          "*Suite*.yml",
          "*Suite*.yaml",
          "*feature*.yml",
          "*feature*.yaml",
          "*Feature*.yml",
          "*Feature*.yaml",
          "*test*.yml",
          "*test*.yaml",
          "*Test*.yml",
          "*Test*.yaml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bdd-suite",
        "scopeName": "source.bdd-suite",
        "path": "./syntaxes/bdd-suite.tmLanguage.json"
      },
      {
        "scopeName": "bdd-suite.injection",
        "path": "./syntaxes/bdd-suite.injection.tmLanguage.json",
        "injectTo": [
          "source.bdd-suite"
        ]
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "action",
        "superType": "function",
        "description": "An action named by a suite step."
      },
      {
        "id": "metaStep",
        "superType": "function",
        "description": "A meta step used by a suite step."
      },
      {
        "id": "field",
        "superType": "property",
        "description": "A field of a capture, in an assertion's subject (`var: location.state`)."
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "implemented",
        "description": "The target binding implements this action."
      },
      {
        "id": "notInTarget",
        "description": "Some binding implements this action, the target binding does not."
      },
      {
        "id": "unimplemented",
        "description": "The catalog declares this action and no binding implements it."
      },
      {
        "id": "undeclared",
        "description": "The catalog does not declare this action, or no meta step of this name is declared or imported."
      },
      {
        "id": "required",
        "description": "A required parameter."
      },
      {
        "id": "unknown",
        "description": "A parameter the action or meta step does not take, or a capture or field not in scope."
      },
      {
        "id": "declaration",
        "description": "The name a step's captureAs publishes."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "bdd-suite",
        "scopes": {
          "action": [
            "entity.name.function.action.bdd-suite"
          ],
          "action.undeclared": [
            "invalid.illegal.action.bdd-suite"
          ],
          "metaStep": [
            "entity.name.type.meta.bdd-suite"
          ],
          "metaStep.undeclared": [
            "invalid.illegal.meta.bdd-suite"
          ],
          "parameter": [
            "variable.parameter.bdd-suite"
          ],
          "parameter.unknown": [
            "invalid.illegal.parameter.bdd-suite"
          ],
          "property": [
            "support.type.property-name.bdd-suite"
          ],
          "variable": [
            "variable.other.capture.bdd-suite"
          ],
          "variable.declaration": [
            "variable.other.definition.bdd-suite"
          ],
          "field": [
            "variable.other.property.bdd-suite"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[bdd-suite]": {
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.autoIndent": "keep",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "action.implemented:bdd-suite": {
            "foreground": "#3fa95b"
          },
          "action.notInTarget:bdd-suite": {
            "foreground": "#e5534b",
            "italic": true
          },
          "action.unimplemented:bdd-suite": {
            "foreground": "#e5534b",
            "italic": true,
            "underline": true
          },
          "action.undeclared:bdd-suite": {
            "foreground": "#e5534b",
            "underline": true
          },
          "metaStep.undeclared:bdd-suite": {
            "foreground": "#e5534b",
            "underline": true
          },
          "parameter:bdd-suite": {
            "foreground": "#9a6fe0"
          },
          "parameter.required:bdd-suite": {
            "foreground": "#9a6fe0",
            "bold": true
          },
          "parameter.unknown:bdd-suite": {
            "foreground": "#e5534b",
            "strikethrough": true
          },
          "variable:bdd-suite": {
            "foreground": "#1f9bb0"
          },
          "variable.declaration:bdd-suite": {
            "foreground": "#1f9bb0",
            "bold": true
          },
          "variable.unknown:bdd-suite": {
            "foreground": "#e5534b",
            "underline": true
          },
          "field:bdd-suite": {
            "foreground": "#9a6fe0"
          },
          "field.unknown:bdd-suite": {
            "foreground": "#e5534b",
            "underline": true
          }
        }
      }
    },
    "configuration": {
      "title": "Suite Authoring",
      "properties": {
        "bddSuite.catalogPath": {
          "type": "string",
          "default": "test/e2e/schema/actions.catalog.yaml",
          "description": "The action catalog, relative to the workspace folder. Its folder holds suite.schema.json and is the schema root every binding program reads."
        },
        "bddSuite.root": {
          "type": "string",
          "default": "",
          "description": "The suites' root, relative to the workspace folder: binding programs run in it, and each binding's `tool`, `build.cwd`, `library` and `stubFile` are relative to it. Empty: the nearest folder above the catalog holding test/e2e/schema, else the folder above the catalog's folder."
        },
        "bddSuite.suiteGlobs": {
          "type": "array",
          "default": [
            "test/e2e/**/*.yml"
          ],
          "description": "Candidate suite files; a file is a suite when it has a top-level `suite:` key or is imported by one.",
          "items": {
            "type": "string"
          }
        },
        "bddSuite.exclude": {
          "type": "string",
          "default": "**/{node_modules,bin,obj,target,artifacts,.git}/**",
          "description": "Glob of files never indexed."
        },
        "bddSuite.lintTool": {
          "type": "string",
          "default": "typescript",
          "description": "The binding whose code lints suites."
        },
        "bddSuite.targetBinding": {
          "type": "string",
          "default": "powershell",
          "description": "The binding suites are meant to run with; lint reports actions it does not implement (E201)."
        },
        "bddSuite.bindings": {
          "type": "object",
          "default": {
            "powershell": {
              "label": "PowerShell",
              "abbreviation": "PS",
              "sources": [
                "scripts/e2e/actions/*.ps1"
              ],
              "exclude": [
                "**/*.Tests.ps1"
              ],
              "recognizers": [
                {
                  "pattern": "Register-(?:Suite|Lab)Action\\s+-Name\\s+'(?<name>[^'$]+)'"
                },
                {
                  "pattern": "Register-(?:Suite|Lab)Action\\s+-Name\\s+\"(?<name>[^\"$]+)\""
                }
              ],
              "tool": [
                "pwsh",
                "-NoProfile",
                "-NonInteractive",
                "-File",
                "scripts/e2e/suiterun.ps1"
              ],
              "selectsOneCase": true
            },
            "csharp": {
              "label": "C#",
              "abbreviation": "C#",
              "sources": [
                "test/e2e/bindings/dotnet/**/*.cs"
              ],
              "exclude": [
                "**/{artifacts,bin,obj}/**"
              ],
              "recognizers": [
                {
                  "pattern": "new ActionRegistration\\(\\s*\"(?<name>[^\"]+)\"(?:\\s*,\\s*(?<handler>[\\w.]+)\\s*\\))?"
                },
                {
                  "pattern": "^[ \\t]*\\[\"(?<name>[\\w-]+(?:\\.[\\w-]+)+)\"\\][ \\t]*=[ \\t]*(?<handler>(?!(?:true|false|null)\\b)[A-Za-z_][\\w.]*)[ \\t]*,[ \\t]*\\r?$"
                }
              ],
              "tool": [
                "test/e2e/bindings/dotnet/artifacts/bin/Suite.Cli/Debug/net10.0/suiterun.exe"
              ],
              "build": {
                "command": "dotnet build",
                "cwd": "test/e2e/bindings/dotnet"
              }
            },
            "go": {
              "label": "Go",
              "abbreviation": "Go",
              "sources": [
                "test/e2e/bindings/go/**/*.go"
              ],
              "exclude": [
                "**/*_test.go"
              ],
              "recognizers": [
                {
                  "pattern": "\\{\\s*Name:\\s*\"(?<name>[^\"]+)\",\\s*Handler:(?:\\s*(?<handler>[\\w.]+)\\s*[,}])?"
                }
              ],
              "tool": [
                "${storage}/go/suiterun.exe"
              ],
              "build": {
                "command": "go build -o ${storage}/go/suiterun.exe ./cmd/suiterun",
                "cwd": "test/e2e/bindings/go"
              }
            },
            "rust": {
              "label": "Rust",
              "abbreviation": "Rs",
              "sources": [
                "test/e2e/bindings/rust/src/**/*.rs"
              ],
              "exclude": [],
              "recognizers": [
                {
                  "pattern": "Action::new\\(\\s*\"(?<name>[^\"]+)\"(?:\\s*,\\s*(?<handler>[\\w:]+)\\s*\\))?"
                }
              ],
              "tool": [
                "test/e2e/bindings/rust/target/debug/suiterun.exe"
              ],
              "build": {
                "command": "cargo build",
                "cwd": "test/e2e/bindings/rust"
              }
            },
            "typescript": {
              "label": "TypeScript",
              "abbreviation": "TS",
              "sources": [
                "test/e2e/bindings/typescript/src/**/*.ts"
              ],
              "exclude": [
                "**/*.test.ts"
              ],
              "recognizers": [
                {
                  "pattern": "\\baction\\(\\s*'(?<name>[^']+)'(?:\\s*,\\s*(?<handler>[\\w.]+)\\s*\\))?"
                }
              ],
              "tool": [
                "node",
                "test/e2e/bindings/typescript/dist/cli.js"
              ],
              "build": {
                "command": "npm ci && npm run build",
                "cwd": "test/e2e/bindings/typescript",
                "shell": true
              },
              "library": "test/e2e/bindings/typescript/dist/index.js"
            }
          },
          "description": "Per binding: source globs (the catalog's `bindingSources`, when it has them, win), registration recognizers, program (its `suiterun`, which every binding calls with the same verbs and flags), build command, `selectsOneCase` when the program runs one case by name, and `stubFile`, where Declare action writes a stub (PowerShell: `${action}` is the action's PascalCase name)."
        },
        "bddSuite.schemaGenerator": {
          "type": "array",
          "default": [
            "pwsh",
            "-NoProfile",
            "-NonInteractive",
            "-File",
            "${extension}/spec/Build-Schema.ps1",
            "-Catalog",
            "${catalogPath}"
          ],
          "description": "Command that regenerates suite.schema.json after a catalog edit, run in the workspace root. `${extension}` is the extension's folder (the default runs the spec's Build-Schema.ps1 it carries) and `${catalogPath}` the catalog.",
          "items": {
            "type": "string"
          }
        },
        "bddSuite.inlayHints.bindings": {
          "type": "boolean",
          "default": true,
          "description": "Show which bindings implement each step's action."
        },
        "bddSuite.codeLens.implement": {
          "type": "boolean",
          "default": true,
          "description": "Above a step whose action is missing in a language, offer to declare or implement it."
        },
        "bddSuite.templatesDir": {
          "type": "string",
          "default": "",
          "description": "Workspace directory whose files override the stub templates."
        },
        "bddSuite.lab.apiUrl": {
          "type": "string",
          "default": "",
          "description": "The API URL of the environment (lab) a lab run targets; prompted when empty."
        },
        "bddSuite.lab.labId": {
          "type": "string",
          "default": "",
          "description": "The id of the environment (lab) a lab run targets; prompted when empty."
        },
        "bddSuite.lab.connectionFile": {
          "type": "string",
          "default": "",
          "description": "The connection file of the environment (lab) a lab run targets; prompted when empty."
        },
        "bddSuite.offlineActions": {
          "type": "array",
          "default": [
            "core.*",
            "wait"
          ],
          "description": "Actions that run without a lab, as names or `prefix.*`; a suite using any other action is a lab suite, and its run asks for the lab and a confirmation.",
          "items": {
            "type": "string"
          }
        },
        "bddSuite.contextKeys": {
          "type": "array",
          "default": [],
          "description": "Context keys the workspace's runtime extensions add (each read as ${key}), offered by completion beside the core's `timeoutSec` and `defaults`.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": [
      {
        "command": "bddSuite.showActions",
        "title": "Show actions implemented by binding...",
        "category": "Suite"
      },
      {
        "command": "bddSuite.buildLintTool",
        "title": "Build lint tool",
        "category": "Suite"
      },
      {
        "command": "bddSuite.chooseLintTool",
        "title": "Choose lint tool...",
        "category": "Suite"
      },
      {
        "command": "bddSuite.chooseTargetBinding",
        "title": "Choose target binding...",
        "category": "Suite"
      },
      {
        "command": "bddSuite.configureLint",
        "title": "Configure lint...",
        "category": "Suite"
      },
      {
        "command": "bddSuite.declareAction",
        "title": "Declare action",
        "category": "Suite"
      },
      {
        "command": "bddSuite.implementAction",
        "title": "Implement action in binding...",
        "category": "Suite"
      },
      {
        "command": "bddSuite.regenerateSchema",
        "title": "Regenerate the schema",
        "category": "Suite"
      },
      {
        "command": "bddSuite.verifyBindingPrograms",
        "title": "Verify with binding programs",
        "category": "Suite",
        "icon": "$(checklist)"
      },
      {
        "command": "bddSuite.copyBindingTable",
        "title": "Copy binding table",
        "category": "Suite",
        "icon": "$(copy)"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "bddSuite.bindings",
          "name": "Suite bindings",
          "when": "bddSuite.active"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bddSuite.verifyBindingPrograms",
          "when": "view == bddSuite.bindings",
          "group": "navigation"
        },
        {
          "command": "bddSuite.copyBindingTable",
          "when": "view == bddSuite.bindings",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p . && node esbuild.mjs",
    "build:test": "tsc -p tsconfig.test.json",
    "test:unit": "npm run build:test && c8 --100 --include \"out-test/src/core/**\" --include \"out-test/src/config/**\" --include \"out-test/src/tools/**\" --include \"out-test/src/lint/workerHost.js\" --reporter=text --reporter=text-summary node --test \"out-test/test/unit/**/*.test.js\"",
    "test:integration": "npm run compile && npm run build:test && node --test --test-timeout=900000 \"out-test/test/integration/node/*.test.js\" && node out-test/test/integration/runTest.js",
    "sync-defaults": "npm run build:test && node scripts/sync-defaults.mjs",
    "set-version": "npm run build:test && node scripts/set-version.mjs",
    "check-versions": "npm run build:test && node scripts/check-versions.mjs",
    "test:demo": "npm run build:test && node out-test/test/e2e-demo/run.js",
    "demo:workspace": "node scripts/demo-workspace.mjs",
    "install:local": "node scripts/install-local.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "minimatch": "^9.0.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.0.0",
    "c8": "^10.1.3",
    "esbuild": "^0.25.0",
    "mocha": "^11.0.0",
    "typescript": "~5.9.0"
  }
}
