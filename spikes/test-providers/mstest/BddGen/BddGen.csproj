<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tiny stand-in for the real YAML -> MSTest generator. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- not a test project: drop the package refs injected by ../Directory.Build.targets -->
  <ItemGroup>
    <PackageReference Remove="MSTest.TestFramework;MSTest.TestAdapter;Microsoft.NET.Test.Sdk" />
  </ItemGroup>
</Project>
