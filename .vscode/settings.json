{
  "sarif-viewer.connectToGithubCodeScanning": "off",

  // Suite Authoring in this window: use the demo workspace under
  // test/e2e-demo/fixture. Paths are relative to this repository; the
  // extension finds the repository root of the fixture (the folder holding
  // test/e2e/schema) and runs its tools there. Scaffolding commands edit the
  // fixture's files in place: `git checkout -- test/e2e-demo/fixture` undoes them.
  "bddSuite.catalogPath": "test/e2e-demo/fixture/test/e2e/schema/actions.catalog.yaml",
  "bddSuite.suiteGlobs": ["test/e2e-demo/fixture/test/e2e/**/*.yml"],
  "bddSuite.lintTool": "go",
  "bddSuite.targetBinding": "powershell",
  "bddSuite.schemaGenerator": ["node", "tools/gen-schema.mjs"],

  // The demo's actions touch no lab, so its suites run offline:
  // no lab values and no lab confirmation. (The default is core.* and wait.)
  "bddSuite.offlineActions": ["core.*", "wait", "demo.*", "orders.*"],
  "bddSuite.bindings": {
    "powershell": { "sources": ["test/e2e-demo/fixture/scripts/e2e/actions/*.ps1"] },
    "csharp": { "sources": ["test/e2e-demo/fixture/test/e2e/bindings/dotnet/**/*.cs"] },
    "go": {
      "sources": ["test/e2e-demo/fixture/test/e2e/bindings/go/**/*.go"],
      "tool": ["node", "tools/fake-lint.mjs"]
    },
    "rust": { "sources": ["test/e2e-demo/fixture/test/e2e/bindings/rust/src/**/*.rs"] },
    "typescript": { "sources": ["test/e2e-demo/fixture/test/e2e/bindings/typescript/src/**/*.ts"] }
  },

  // The demo suites open in the BDD Suite language mode: schema checks,
  // action and parameter highlighting, step-key completion.
  "files.associations": {
    "**/test/e2e-demo/fixture/test/e2e/suites/**/*.yml": "bdd-suite"
  }
}
